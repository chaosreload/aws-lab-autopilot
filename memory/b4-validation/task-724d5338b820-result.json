{
  "verdict": "go",
  "task_type": "api_call",
  "task_type_reason": "All tests invoke Bedrock Runtime APIs (Converse, InvokeModel) with new structured output parameters; no resource creation needed",
  "notes_path": "",
  "test_matrix": [
    {
      "id": "T1",
      "name": "Converse API structured output with JSON schema",
      "description": "Verify Converse API returns schema-compliant JSON when outputConfig.textFormat specifies a json_schema",
      "priority": "P0",
      "type": "api_call",
      "prerequisites": [],
      "api_hints": {
        "service": "bedrock-runtime",
        "operation": "Converse",
        "request_body": {
          "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "Extract the name, age, and city from: John is 30 years old and lives in Seattle."
                }
              ]
            }
          ],
          "outputConfig": {
            "textFormat": {
              "type": "json_schema",
              "structure": {
                "jsonSchema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "age": {
                      "type": "integer"
                    },
                    "city": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "age",
                    "city"
                  ]
                }
              }
            }
          }
        }
      },
      "infrastructure_hints": {},
      "validation_criteria": {
        "type": "response_structure",
        "expected": "Response body contains valid JSON with exactly keys name (string), age (integer), city (string); parseable as JSON; values match John, 30, Seattle"
      }
    },
    {
      "id": "T2",
      "name": "Converse vs InvokeModel structured output comparison",
      "description": "Compare structured output via Converse API (outputConfig.textFormat) and InvokeModel (output_config.format) using the same schema to verify feature parity",
      "priority": "P0",
      "type": "api_call",
      "prerequisites": [],
      "api_hints": {
        "service": "bedrock-runtime",
        "operations": [
          {
            "operation": "Converse",
            "request_body": {
              "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "List 3 primary colors with their hex codes"
                    }
                  ]
                }
              ],
              "outputConfig": {
                "textFormat": {
                  "type": "json_schema",
                  "structure": {
                    "jsonSchema": {
                      "type": "object",
                      "properties": {
                        "colors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "hex": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "hex"
                            ]
                          }
                        }
                      },
                      "required": [
                        "colors"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "operation": "InvokeModel",
            "request_body": {
              "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
              "contentType": "application/json",
              "body": {
                "anthropic_version": "bedrock-2023-05-31",
                "max_tokens": 1024,
                "messages": [
                  {
                    "role": "user",
                    "content": "List 3 primary colors with their hex codes"
                  }
                ],
                "output_config": {
                  "format": {
                    "type": "json_schema",
                    "json_schema": {
                      "type": "object",
                      "properties": {
                        "colors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "hex": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "hex"
                            ]
                          }
                        }
                      },
                      "required": [
                        "colors"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "infrastructure_hints": {},
      "validation_criteria": {
        "type": "comparison",
        "expected": "Both APIs return valid JSON conforming to the same schema with a colors array of objects containing name and hex fields; both responses are parseable JSON"
      }
    },
    {
      "id": "T3",
      "name": "Strict tool use with schema-validated tool calls",
      "description": "Verify tool definitions with strict:true flag produce schema-compliant tool call inputs via Converse API",
      "priority": "P0",
      "type": "api_call",
      "prerequisites": [],
      "api_hints": {
        "service": "bedrock-runtime",
        "operation": "Converse",
        "request_body": {
          "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
          "messages": [
            {
              "role": "user",
              "content": [
                {
                  "text": "What is the weather in Seattle?"
                }
              ]
            }
          ],
          "toolConfig": {
            "tools": [
              {
                "toolSpec": {
                  "name": "get_weather",
                  "description": "Get weather for a location",
                  "inputSchema": {
                    "json": {
                      "type": "object",
                      "properties": {
                        "city": {
                          "type": "string"
                        },
                        "units": {
                          "type": "string",
                          "enum": [
                            "celsius",
                            "fahrenheit"
                          ]
                        }
                      },
                      "required": [
                        "city",
                        "units"
                      ]
                    }
                  },
                  "strict": true
                }
              }
            ]
          }
        }
      },
      "infrastructure_hints": {},
      "validation_criteria": {
        "type": "response_structure",
        "expected": "Response contains toolUse stop reason; tool call input has city (string) and units (one of celsius/fahrenheit); input strictly conforms to the defined schema"
      }
    },
    {
      "id": "T4",
      "name": "Combined invalid inputs - malformed schema and unsupported type",
      "description": "Send requests with invalid JSON schema (missing required fields, unsupported format type) and verify appropriate error responses",
      "priority": "P1",
      "type": "api_call",
      "prerequisites": [],
      "api_hints": {
        "service": "bedrock-runtime",
        "operation": "Converse",
        "test_cases": [
          {
            "case": "invalid_schema_type",
            "request_body": {
              "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "Hello"
                    }
                  ]
                }
              ],
              "outputConfig": {
                "textFormat": {
                  "type": "xml_schema",
                  "structure": {
                    "jsonSchema": {
                      "type": "object"
                    }
                  }
                }
              }
            },
            "expected_error": "ValidationException for unsupported type"
          },
          {
            "case": "malformed_json_schema",
            "request_body": {
              "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "Hello"
                    }
                  ]
                }
              ],
              "outputConfig": {
                "textFormat": {
                  "type": "json_schema",
                  "structure": {
                    "jsonSchema": {
                      "type": "invalid_type_name",
                      "properties": 123
                    }
                  }
                }
              }
            },
            "expected_error": "ValidationException for malformed schema"
          },
          {
            "case": "unsupported_model",
            "request_body": {
              "modelId": "anthropic.claude-3-haiku-20240307-v1:0",
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "Hello"
                    }
                  ]
                }
              ],
              "outputConfig": {
                "textFormat": {
                  "type": "json_schema",
                  "structure": {
                    "jsonSchema": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "x"
                      ]
                    }
                  }
                }
              }
            },
            "expected_error": "ValidationException or error indicating model does not support structured outputs"
          }
        ]
      },
      "infrastructure_hints": {},
      "validation_criteria": {
        "type": "error_response",
        "expected": "All three cases return appropriate error responses (ValidationException or similar) with descriptive error messages; no 5xx errors"
      }
    },
    {
      "id": "T5",
      "name": "Combined boundary tests - empty object schema and deeply nested schema",
      "description": "Test boundary conditions: minimal empty-object schema, and a deeply nested schema to stress-test constrained decoding limits",
      "priority": "P1",
      "type": "api_call",
      "prerequisites": [],
      "api_hints": {
        "service": "bedrock-runtime",
        "operation": "Converse",
        "test_cases": [
          {
            "case": "minimal_empty_object_schema",
            "request_body": {
              "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "Say hello"
                    }
                  ]
                }
              ],
              "outputConfig": {
                "textFormat": {
                  "type": "json_schema",
                  "structure": {
                    "jsonSchema": {
                      "type": "object"
                    }
                  }
                }
              }
            },
            "expected": "Returns valid JSON object (possibly empty or with arbitrary keys)"
          },
          {
            "case": "deeply_nested_schema_10_levels",
            "request_body": {
              "modelId": "anthropic.claude-sonnet-4-5-20250929-v1:0",
              "messages": [
                {
                  "role": "user",
                  "content": [
                    {
                      "text": "Generate nested data"
                    }
                  ]
                }
              ],
              "outputConfig": {
                "textFormat": {
                  "type": "json_schema",
                  "structure": {
                    "jsonSchema": {
                      "type": "object",
                      "properties": {
                        "l1": {
                          "type": "object",
                          "properties": {
                            "l2": {
                              "type": "object",
                              "properties": {
                                "l3": {
                                  "type": "object",
                                  "properties": {
                                    "l4": {
                                      "type": "object",
                                      "properties": {
                                        "l5": {
                                          "type": "object",
                                          "properties": {
                                            "value": {
                                              "type": "string"
                                            }
                                          },
                                          "required": [
                                            "value"
                                          ]
                                        }
                                      },
                                      "required": [
                                        "l5"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "l4"
                                  ]
                                }
                              },
                              "required": [
                                "l3"
                              ]
                            }
                          },
                          "required": [
                            "l2"
                          ]
                        }
                      },
                      "required": [
                        "l1"
                      ]
                    }
                  }
                }
              }
            },
            "expected": "Returns valid JSON conforming to 5-level nested schema OR returns error indicating nesting depth limit exceeded"
          }
        ]
      },
      "infrastructure_hints": {},
      "validation_criteria": {
        "type": "boundary_validation",
        "expected": "Empty object schema returns valid JSON; deeply nested schema either returns conforming JSON or a descriptive error about nesting limits"
      }
    }
  ],
